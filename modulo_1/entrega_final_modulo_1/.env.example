# Copy this file to .env and fill in the keys you have.
# You only need the key of the provider you are going to use.

# Provider the manager loads: openai, anthropic or gemini
LLM_PROVIDER=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Leave empty to use the defaults.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
